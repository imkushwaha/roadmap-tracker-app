# Copy to .env and fill in. .env is git-ignored.

# REQUIRED in production (>= 32 chars). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# In development, if unset, a random one is used and logins reset on restart.
SESSION_SECRET=

# SQLite file. Relative paths resolve from the project folder.
# In production this must live on a persistent volume and be backed up.
DB_PATH=./data/app.db

# HTTP port
PORT=3000

# Optional: behind a reverse proxy, set to the number of proxy hops (usually 1)
# so rate limiting sees real client IPs.
# TRUST_PROXY=1

# Optional: cookies are `Secure` (HTTPS-only) when NODE_ENV=production.
# Set to false ONLY for a plain-http production setup such as a LAN box.
# COOKIE_SECURE=false
